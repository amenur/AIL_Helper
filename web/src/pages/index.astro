---
import Layout from '../layouts/Layout.astro';
import OfficeChatDemo from '../components/landing/OfficeChatDemo.svelte';
import CompatCheck from '../components/landing/CompatCheck.svelte';
import SpeedRace from '../components/landing/SpeedRace.svelte';
import { getGpus, getModels } from '../lib/catalog.ts';
import { url } from '../lib/url.ts';

const models = await getModels();
const gpus = await getGpus();

const promises = [
  { icon: '€', title: 'Gratis', text: 'Sin suscripciones ni cuotas por empleado.' },
  { icon: '🔒', title: 'Privado', text: 'Lo que escribes no sale de tu ordenador.' },
  { icon: '✈', title: 'Sin internet', text: 'Una vez instalado, funciona desconectado.' },
  { icon: '⏱', title: 'En unos minutos', text: 'Lo instalamos por ti, sin configurar nada.' },
];

const uses = [
  { title: 'Escribir correos', ask: 'Responde a este cliente que pide un descuento, con amabilidad pero sin ceder.' },
  { title: 'Resumir documentos', ask: 'Resume este informe de 20 páginas en una lista de puntos clave.' },
  { title: 'Atender a clientes', ask: 'Prepara respuestas para las 10 preguntas más habituales sobre nuestros envíos.' },
  { title: 'Traducir', ask: 'Traduce esta oferta al inglés y al francés manteniendo un tono profesional.' },
  { title: 'Presupuestos y ofertas', ask: 'Redacta una propuesta comercial para una reforma de cocina a partir de estas notas.' },
  { title: 'Ideas y textos', ask: 'Dame 5 ideas de publicaciones para las redes sociales de mi tienda en noviembre.' },
];

const steps = [
  {
    n: '1',
    title: 'Descarga la app',
    text: 'Un programa pequeño para Windows. Lo abres y se conecta solo con esta web.',
  },
  {
    n: '2',
    title: 'Elige tu asistente',
    text: 'Rápido, equilibrado o más inteligente. Comprobamos tu ordenador y te recomendamos el que mejor le va.',
  },
  {
    n: '3',
    title: 'Empieza a usarlo',
    text: 'Lo descargamos e instalamos por ti. Se abre en tu navegador, igual que ChatGPT, pero dentro de tu ordenador.',
  },
];

const reasons = [
  {
    title: 'Los datos de tu empresa, en tu empresa',
    text: 'Contratos, datos de clientes o nóminas no viajan a servidores de otros. Mucho más fácil de encajar con el RGPD y con tus políticas de confidencialidad.',
  },
  {
    title: 'Sin cuotas por usuario',
    text: 'Las IA en la nube se pagan por persona y mes. Esta es gratis, la uses tú solo o todo tu equipo.',
  },
  {
    title: 'Funciona sin conexión',
    text: 'En la oficina, en un viaje o con una conexión inestable: una vez instalado, no necesita internet.',
  },
  {
    title: 'Sin límites de mensajes',
    text: 'Pregunta todo lo que quieras. Nadie te corta a mitad de día ni te cobra por usarlo más.',
  },
];

const faqs = [
  {
    q: '¿Es lo mismo que ChatGPT?',
    a: 'Funciona de forma parecida: escribes una pregunta y te responde. La diferencia es que este asistente vive en tu ordenador, así que es privado, gratis y funciona sin internet. A cambio, para tareas muy complejas, ChatGPT y otras IA en la nube siguen siendo más potentes. No tenemos relación con OpenAI.',
  },
  {
    q: '¿Necesito saber de informática?',
    a: 'No. Descargas la app, la abres y pulsas un botón. Nosotros comprobamos tu ordenador, elegimos lo que mejor le va y lo instalamos. No hay que configurar nada.',
  },
  {
    q: '¿Qué ordenador necesito?',
    a: 'Un ordenador con Windows 10 u 11 y, como mínimo, 8 GB de memoria RAM (mejor 16 GB). Con una tarjeta gráfica, sobre todo NVIDIA, las respuestas son mucho más rápidas. Antes de instalar te decimos si tu equipo está preparado.',
  },
  {
    q: '¿Funciona en Mac?',
    a: 'Todavía no. Empezamos por Windows y la versión para Mac llegará más adelante.',
  },
  {
    q: '¿Cuánto ocupa?',
    a: 'Entre 10 y 25 GB en total: hasta 7 GB de la pantalla de chat y entre 3 y 18 GB del asistente que elijas. La primera instalación tarda un rato porque se descarga todo de una vez (depende de tu conexión); después ya no necesita descargar nada.',
  },
  {
    q: '¿Es seguro? ¿Mis datos salen de mi ordenador?',
    a: 'Tus conversaciones nunca salen de tu ordenador. La app solo descarga programas y asistentes de fuentes oficiales y comprueba que no se hayan modificado. Su código es público, y cualquiera puede revisar lo que hace.',
  },
  {
    q: '¿Lo pueden usar varias personas de mi empresa?',
    a: 'Sí: cada persona lo instala en su propio ordenador, sin coste y sin límite de instalaciones.',
  },
  {
    q: '¿Y si algo no funciona?',
    a: 'Si la instalación falla, la app te lo dirá y te mostrará los detalles para poder ayudarte. Puedes volver a intentarlo en cualquier momento sin perder lo que ya se haya descargado.',
  },
];
---

<Layout
  title="AIL Helper · Tu asistente de IA privado y gratis"
  description="Un asistente de inteligencia artificial como ChatGPT, pero en tu ordenador: privado, gratis y sin internet. Lo instalamos por ti en unos minutos."
  fullWidth
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-sky-500/20 blur-[120px]"></div>
    <div class="pointer-events-none absolute top-40 -right-40 h-[360px] w-[360px] rounded-full bg-lime-400/10 blur-[100px]"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pt-16 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">
          <span class="h-1.5 w-1.5 rounded-full bg-lime-400"></span>
          Para pymes, autónomos y cualquier persona
        </p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-50 sm:text-6xl lg:text-[3.9rem] lg:leading-[1.05]">
          Tu propio asistente de IA, <span class="text-gradient">privado y gratis.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
          Funciona como ChatGPT, pero dentro de tu ordenador: los datos de tu empresa no salen de él, no pagas cuotas y funciona sin
          internet. <strong class="font-semibold text-slate-100">Lo instalamos por ti en unos minutos.</strong>
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={url('/empezar')} class="btn btn-lg shadow-lg shadow-sky-500/25">
            Empezar gratis
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
              ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
            >
          </a>
          <a href="#como" class="text-slate-300 underline-offset-4 hover:text-white hover:underline">¿Cómo funciona?</a>
        </div>
        <CompatCheck client:load {models} {gpus} />
        <p class="mt-2 text-sm text-slate-400">Para Windows 10 y 11 · Sin registro · Mac, próximamente</p>
      </div>

      <div>
        <OfficeChatDemo client:load />
      </div>
    </div>
  </section>

  <!-- ============ PROMESAS ============ -->
  <section class="border-y border-white/5 bg-white/[0.02]">
    <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-10 lg:grid-cols-4">
      {
        promises.map((p) => (
          <li class="flex gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-sky-400/10 text-lg text-sky-200" aria-hidden="true">
              {p.icon}
            </span>
            <div>
              <p class="font-semibold text-slate-100">{p.title}</p>
              <p class="text-sm text-slate-400">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ USOS ============ -->
  <section id="usos" class="section scroll-mt-16">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">¿Para qué te sirve?</p>
      <h2 class="h2">Las tareas de cada día, en la mitad de tiempo</h2>
      <p class="lead">Pídeselo como se lo pedirías a un compañero. Estos son algunos ejemplos reales:</p>
    </div>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        uses.map((u) => (
          <li class="reveal glass p-6">
            <h3 class="text-lg font-semibold text-slate-100">{u.title}</h3>
            <p class="mt-3 rounded-2xl rounded-br-sm bg-sky-500/10 px-4 py-3 text-sm text-sky-50">«{u.ask}»</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ CÓMO FUNCIONA ============ -->
  <section id="como" class="scroll-mt-16 border-y border-white/5 bg-gradient-to-b from-sky-950/20 to-transparent">
    <div class="section">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Así de fácil</p>
        <h2 class="h2">Tres pasos y listo</h2>
        <p class="lead">Sin configurar nada y sin conocimientos técnicos.</p>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="reveal glass p-7">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-sky-500 text-xl font-bold text-slate-950">{s.n}</span>
              <h3 class="mt-5 text-xl font-semibold text-slate-100">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-slate-400">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="reveal mt-12 text-center">
        <a href={url('/empezar')} class="btn btn-lg">Empezar gratis</a>
      </div>
    </div>
  </section>

  <!-- ============ POR QUÉ LOCAL ============ -->
  <section id="privacidad" class="section scroll-mt-16">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">¿Por qué en tu ordenador?</p>
      <h2 class="h2">Tu información, bajo tu control</h2>
    </div>
    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        reasons.map((r) => (
          <article class="reveal glass p-7">
            <h3 class="text-lg font-semibold text-slate-100">
              <span class="mr-2 text-lime-400">✓</span>
              {r.title}
            </h3>
            <p class="mt-2 leading-relaxed text-slate-400">{r.text}</p>
          </article>
        ))
      }
    </div>
    <p class="reveal mx-auto mt-8 max-w-3xl rounded-xl border border-white/10 bg-white/[0.03] p-5 text-center text-slate-400">
      <strong class="text-slate-200">Para ser claros:</strong> para tareas muy complejas, las IA en la nube como ChatGPT siguen siendo más
      potentes. Para el trabajo de cada día (escribir, resumir, traducir, ordenar ideas), un asistente en tu ordenador cumple de sobra.
    </p>
  </section>

  <!-- ============ VELOCIDAD ============ -->
  <section id="carrera" class="scroll-mt-16 border-y border-white/5 bg-white/[0.015]">
    <div class="section">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">¿Me irá bien?</p>
        <h2 class="h2">Depende de tu ordenador</h2>
        <p class="lead">
          Mira cuánto tarda la misma respuesta en tres ordenadores distintos. Antes de instalar, comprobamos el tuyo y te decimos qué esperar.
        </p>
      </div>
      <div class="reveal mt-12">
        <SpeedRace client:visible {models} {gpus} />
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="section scroll-mt-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
      <div class="reveal">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="h2">Lo que todo el mundo pregunta</h2>
      </div>
      <div class="divide-y divide-white/10 border-y border-white/10">
        {
          faqs.map((f) => (
            <details class="reveal group py-5" name="faq">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-medium text-slate-100 [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-white/10 text-slate-400 transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 pr-12 leading-relaxed text-slate-400">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="mx-auto max-w-6xl px-4 pb-24">
    <div
      class="reveal relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-sky-500/20 via-slate-900 to-lime-400/10 px-6 py-16 text-center sm:px-16"
    >
      <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
      <h2 class="relative text-3xl font-bold tracking-tight text-slate-50 sm:text-5xl">Tu asistente privado, en unos minutos</h2>
      <p class="relative mx-auto mt-4 max-w-xl text-lg text-slate-300">Gratis, sin registro y sin configurar nada.</p>
      <a href={url('/empezar')} class="btn btn-lg relative mt-8 shadow-lg shadow-sky-500/30">Empezar gratis</a>
    </div>
  </section>
</Layout>
