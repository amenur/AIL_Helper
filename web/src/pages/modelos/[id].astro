---
import Layout from '../../layouts/Layout.astro';
import HardwarePanel from '../../components/HardwarePanel.svelte';
import ModelWorkbench from '../../components/ModelWorkbench.svelte';
import { getGpus, getModels } from '../../lib/catalog.ts';
import { params, ctxLabel } from '../../lib/format.ts';
import type { Model } from '../../lib/types.ts';

export async function getStaticPaths() {
  const models = await getModels();
  return models.map((model) => ({ params: { id: model.id }, props: { model } }));
}

const { model } = Astro.props as { model: Model };
const gpus = await getGpus();
---

<Layout
  title={`${model.name}: requisitos y velocidad en local`}
  description={`¿Puedes ejecutar ${model.name} en tu PC? Memoria necesaria, velocidad estimada con llama.cpp e instalación con Open WebUI.`}
>
  <a href="/" class="text-sm text-slate-400 hover:text-slate-200">← Todos los modelos</a>
  <header class="mt-3 mb-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-50">{model.name}</h1>
    <p class="mt-2 max-w-3xl text-slate-400">{model.description}</p>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <div><dt class="inline text-slate-500">Organización: </dt><dd class="inline text-slate-200">{model.org}</dd></div>
      <div>
        <dt class="inline text-slate-500">Parámetros: </dt>
        <dd class="inline text-slate-200">{params(model.paramsB)}{model.activeParamsB && ` (${params(model.activeParamsB)} activos)`}</dd>
      </div>
      <div><dt class="inline text-slate-500">Contexto máx.: </dt><dd class="inline text-slate-200">{ctxLabel(model.maxContext)}</dd></div>
      <div><dt class="inline text-slate-500">Licencia: </dt><dd class="inline text-slate-200">{model.license}</dd></div>
      <div>
        <dt class="inline text-slate-500">GGUF: </dt>
        <dd class="inline"><a class="text-sky-300 hover:underline" href={`https://huggingface.co/${model.hfRepo}`}>{model.hfRepo}</a></dd>
      </div>
    </dl>
  </header>

  <div class="flex flex-col gap-6">
    <HardwarePanel client:only="svelte" {gpus} compact />
    <ModelWorkbench client:only="svelte" {model} {gpus} />
  </div>
</Layout>
