---
import '../styles/global.css';
import { url } from '../lib/url.ts';

interface Props {
  title: string;
  description?: string;
  /** Sin contenedor central: la página controla el ancho de cada sección (landing). */
  fullWidth?: boolean;
}
const {
  title,
  description = 'Analiza tu equipo y descubre qué modelos de IA puedes ejecutar en local, y a qué velocidad.',
  fullWidth = false,
} = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
// URLs absolutas (solo cuando se conoce el dominio, en el despliegue).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(url('/og.png'), Astro.site).href : null;
const nav = [
  { href: '/#como', label: 'Cómo funciona' },
  { href: '/#carrera', label: 'Demo' },
  { href: '/analizar#modelos', label: 'Modelos' },
  { href: '/#faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href={url('/sitemap-index.xml')} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="AIL Helper" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#020617" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-50 border-b border-white/5 bg-slate-950/70 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href={url('/')} class="flex items-center gap-2 font-semibold text-slate-100">
          <img src={url('/favicon.svg')} alt="" class="h-7 w-7" />
          AIL Helper
        </a>
        <div class="flex items-center gap-6 text-sm">
          <div class="hidden gap-6 text-slate-400 md:flex">
            {nav.map((n) => <a href={url(n.href)} class="transition-colors hover:text-slate-100">{n.label}</a>)}
          </div>
          <a
            href="https://github.com/amenur/AIL_Helper"
            class="text-slate-400 transition-colors hover:text-slate-100"
            aria-label="Código en GitHub"
            title="Código en GitHub"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" />
            </svg>
          </a>
          {
            path !== '/analizar' && (
              <a href={url('/analizar')} class="btn py-1.5">
                Analizar mi equipo
              </a>
            )
          }
        </div>
      </nav>
    </header>
    {
      fullWidth ? (
        <main>
          <slot />
        </main>
      ) : (
        <main class="mx-auto max-w-6xl px-4 py-8">
          <slot />
        </main>
      )
    }
    <footer class="border-t border-white/5">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-slate-400 sm:flex-row sm:justify-between">
        <div class="max-w-sm">
          <div class="flex items-center gap-2 font-semibold text-slate-300">
            <img src={url('/favicon.svg')} alt="" class="h-6 w-6" /> AIL Helper
          </div>
          <p class="mt-2 text-xs text-slate-400">
            Estimaciones orientativas basadas en ancho de banda de memoria y cómputo; el rendimiento real puede variar ±30 %.
          </p>
        </div>
        <div class="flex gap-10 text-xs">
          <ul class="space-y-2">
            <li class="font-medium text-slate-300">Producto</li>
            <li><a class="hover:text-slate-200" href={url('/analizar')}>Analizar mi equipo</a></li>
            <li><a class="hover:text-slate-200" href={url('/analizar#modelos')}>Modelos</a></li>
            <li><a class="hover:text-slate-200" href={url('/como-funciona')}>Metodología</a></li>
            <li><a class="hover:text-slate-200" href="https://github.com/amenur/AIL_Helper">Código en GitHub</a></li>
            <li><a class="hover:text-slate-200" href="https://github.com/amenur/AIL_Helper/blob/main/LICENSE">Licencia MIT</a></li>
          </ul>
          <ul class="space-y-2">
            <li class="font-medium text-slate-300">Proyectos</li>
            <li><a class="hover:text-slate-200" href="https://github.com/ggml-org/llama.cpp">llama.cpp</a></li>
            <li><a class="hover:text-slate-200" href="https://openwebui.com">Open WebUI</a></li>
            <li><a class="hover:text-slate-200" href="https://huggingface.co/models?library=gguf">Hugging Face</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
