---
import { url } from '../../lib/url.ts';

const cases = [
  {
    title: 'Programar sin enviar tu código',
    text: 'Un asistente que revisa, explica y escribe código sin que tu repositorio salga de tu máquina.',
    model: { id: 'qwen2.5-coder-7b', name: 'Qwen2.5 Coder' },
    icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  },
  {
    title: 'Documentos confidenciales',
    text: 'Resume contratos, informes médicos o datos de clientes con la tranquilidad de que nadie más los lee.',
    model: { id: 'qwen3-8b', name: 'Qwen3 8B' },
    icon: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  },
  {
    title: 'Sin conexión',
    text: 'En un avión, en el tren o en una red restringida: una vez descargado, el modelo no necesita internet.',
    model: { id: 'gemma-3-4b', name: 'Gemma 3 4B' },
    icon: 'M3 3l18 18M8.5 16.5a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 5.2-2.8M19 12.9a10 10 0 0 0-2.1-1.6M12 20h.01',
  },
  {
    title: 'Sin límites ni cuotas',
    text: 'Pregunta cuanto quieras, automatiza tareas y experimenta: no hay mensajes contados ni facturas por uso.',
    model: { id: 'gpt-oss-20b', name: 'gpt-oss 20B' },
    icon: 'M18.2 8.4a4 4 0 1 1 0 7.2L12 12 5.8 8.4a4 4 0 1 0 0 7.2L12 12',
  },
];
---

<section id="usos" class="section scroll-mt-16">
  <div class="grid items-center gap-14 lg:grid-cols-2">
    <div>
      <div class="reveal">
        <p class="eyebrow">¿Para qué sirve?</p>
        <h2 class="h2">Una IA que trabaja para ti, no con tus datos</h2>
        <p class="lead">Los modelos abiertos ya resuelven la mayoría de tareas del día a día. En local, además, son tuyos.</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          cases.map((c) => (
            <li class="reveal glass p-5">
              <span class="grid h-10 w-10 place-items-center rounded-lg border border-sky-400/30 bg-sky-400/10 text-sky-300">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={c.icon} />
                </svg>
              </span>
              <h3 class="mt-4 font-semibold text-slate-100">{c.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{c.text}</p>
              <a href={url(`/modelos/${c.model.id}`)} class="mt-3 inline-block text-xs text-sky-300 hover:underline">
                Prueba con {c.model.name} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Ilustración del chat final -->
    <figure class="reveal">
      <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900 shadow-2xl shadow-black/40">
        <div class="flex items-center gap-3 border-b border-white/5 bg-slate-950/60 px-4 py-2.5">
          <span class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span
              class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          </span>
          <span class="flex-1 rounded-md bg-white/5 px-3 py-1 text-center font-mono text-[11px] text-slate-400">localhost:3000</span>
        </div>
        <div class="flex">
          <aside class="hidden w-40 shrink-0 space-y-1 border-r border-white/5 p-3 text-xs sm:block">
            <div class="rounded-md bg-white/[0.06] px-2 py-1.5 text-slate-200">Revisión de código</div>
            <div class="px-2 py-1.5 text-slate-500">Resumen contrato</div>
            <div class="px-2 py-1.5 text-slate-500">Plan de viaje</div>
            <div class="px-2 py-1.5 text-slate-500">Ideas para la charla</div>
          </aside>
          <div class="flex-1 space-y-4 p-4 text-sm">
            <div class="flex items-center gap-2 text-xs text-slate-400">
              <span class="h-1.5 w-1.5 rounded-full bg-lime-400"></span> qwen2.5-coder-7b · local
            </div>
            <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-sky-500/15 px-3.5 py-2 text-sky-50">
              ¿Ves algún fallo en esta función?
              <pre class="mt-2 rounded-lg bg-slate-950/70 p-2 font-mono text-[11px] leading-relaxed text-sky-200"><code>def media(xs):
    return sum(xs) / len(xs)</code></pre>
            </div>
            <div class="max-w-[92%] rounded-2xl rounded-bl-sm bg-white/[0.05] px-3.5 py-2 leading-relaxed text-slate-200">
              Sí: si <code class="text-lime-300">xs</code> está vacía, <code class="text-lime-300">len(xs)</code> es 0 y lanzará
              <code class="text-rose-300">ZeroDivisionError</code>. Puedes devolver <code class="text-lime-300">None</code> o lanzar un error más
              claro:
              <pre class="mt-2 rounded-lg bg-slate-950/70 p-2 font-mono text-[11px] leading-relaxed text-slate-300"><code>if not xs:
    raise ValueError("lista vacía")</code></pre>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 text-xs text-slate-500">
              Escribe un mensaje…<span class="ml-auto rounded-md bg-sky-500/80 px-2 py-0.5 text-slate-950">↑</span>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="mt-3 text-center text-xs text-slate-400">
        Ilustración. El chat real es <a class="text-sky-300 hover:underline" href="https://openwebui.com">Open WebUI</a>, abierto en tu navegador.
      </figcaption>
    </figure>
  </div>
</section>
